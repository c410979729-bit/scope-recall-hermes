{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local memory management response",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "action", "status"],
  "properties": {
    "format": {"type": "string", "const": "scope-recall-management/1"},
    "action": {
      "type": "string",
      "enum": [
        "list",
        "search",
        "show",
        "history",
        "revise",
        "mute",
        "unmute",
        "forget",
        "forget-session",
        "origin",
        "origin-candidates",
        "export",
        "secrets",
        "entries",
        "entry",
        "entry-state",
        "importance",
        "import",
        "instruction-get",
        "instruction-set",
        "health",
        "health-entity",
        "health-merge",
        "health-choose",
        "health-undo"
      ]
    },
    "status": {"type": "string", "enum": ["ok", "error"]},
    "code": {"type": "string"},
    "field": {"type": ["string", "null"]},
    "data": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"type": "string", "const": "ok"}}}, "then": {"required": ["data"]}},
    {
      "if": {"properties": {"status": {"type": "string", "const": "error"}}},
      "then": {"required": ["code", "field"]}
    },
    {
      "if": {"properties": {"action": {"type": "string", "const": "secrets"}, "status": {"type": "string", "const": "ok"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/secret_inventory"}}}
    },
    {
      "if": {"properties": {"action": {"type": "string", "enum": ["origin", "origin-candidates"]}}},
      "else": {"properties": {"data": {"$ref": "#/$defs/data"}}}
    },
    {
      "if": {"properties": {"action": {"type": "string", "const": "origin"}, "status": {"type": "string", "const": "ok"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/origin_data"}}}
    },
    {
      "if": {"properties": {"action": {"type": "string", "const": "origin-candidates"}, "status": {"type": "string", "const": "ok"}}},
      "then": {"properties": {"data": {"$ref": "#/$defs/origin_candidates"}}}
    }
  ],
  "$defs": {
    "origin_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "reason", "memory_epoch", "sources", "claims", "evaluations", "work", "related", "preview_id"],
      "properties": {
        "origin": {"type": "string", "enum": ["human_direct", "host_generated", "origin_unknown"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "memory_epoch": {"type": "integer", "minimum": 0},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/origin_source"}, "minItems": 1},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/origin_claim"}},
        "evaluations": {"type": "array", "items": {"$ref": "#/$defs/origin_evaluation"}},
        "work": {"type": "array", "items": {"$ref": "#/$defs/origin_work"}},
        "related": {"type": "array", "items": {"$ref": "#/$defs/origin_related"}},
        "preview_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "origin_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "revision", "scope_id", "project_id", "branch_id", "before", "origin_revision"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "scope_id": {"type": "string", "minLength": 1},
        "project_id": {"type": ["string", "null"]},
        "branch_id": {"type": ["string", "null"]},
        "before": {
          "type": "object",
          "additionalProperties": false,
          "required": ["origin", "original_origin", "principal"],
          "properties": {
            "origin": {
              "type": "string",
              "enum": [
                "human_direct",
                "assistant_visible",
                "tool_observation",
                "external_document",
                "host_generated",
                "memory_reinjection",
                "imported",
                "origin_unknown"
              ]
            },
            "original_origin": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "human_direct",
                    "assistant_visible",
                    "tool_observation",
                    "external_document",
                    "host_generated",
                    "memory_reinjection",
                    "imported",
                    "origin_unknown"
                  ]
                },
                {"type": "null"}
              ]
            },
            "principal": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "resolution"],
                  "properties": {
                    "kind": {"type": "string", "enum": ["human", "assistant", "tool", "host", "document", "unknown"]},
                    "resolution": {"type": "string", "enum": ["verified", "unresolved"]},
                    "principal_ref": {"type": "string", "minLength": 1},
                    "display_name": {"type": "string", "minLength": 1}
                  },
                  "allOf": [
                    {
                      "if": {"properties": {"resolution": {"type": "string", "const": "verified"}}},
                      "then": {"required": ["principal_ref"]}
                    }
                  ]
                },
                {"type": "null"}
              ]
            }
          }
        },
        "origin_revision": {"type": "integer", "minimum": 1}
      }
    },
    "origin_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "revision",
        "head_revision",
        "scope_id",
        "project_id",
        "branch_id",
        "state",
        "effect",
        "evidence_refs",
        "versions"
      ],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "head_revision": {"type": "integer", "minimum": 1},
        "scope_id": {"type": "string", "minLength": 1},
        "project_id": {"type": ["string", "null"]},
        "branch_id": {"type": ["string", "null"]},
        "state": {"type": "string", "enum": ["active", "proposed", "disputed", "superseded", "retracted"]},
        "effect": {"type": "string", "enum": ["retract", "mixed_unchanged", "source_view_unchanged", "historical_unchanged", "review"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
        "versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/origin_claim_version"}}
      }
    },
    "origin_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_id", "work_id", "ref", "revision", "state"],
      "properties": {
        "evaluation_id": {"type": "integer", "minimum": 1},
        "work_id": {"type": ["integer", "null"], "minimum": 1},
        "ref": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "state": {"type": "string", "enum": ["queued", "failed"]}
      }
    },
    "origin_work": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_id", "work_type", "subject_ref", "subject_revision", "state", "lease_token"],
      "properties": {
        "work_id": {"type": "integer", "minimum": 1},
        "work_type": {"type": "string", "enum": ["consolidate", "evaluate_candidate"]},
        "subject_ref": {"type": "string", "minLength": 1},
        "subject_revision": {"type": "integer", "minimum": 1},
        "state": {"type": "string", "enum": ["pending", "leased", "failed"]},
        "lease_token": {"type": "integer", "minimum": 0}
      }
    },
    "origin_related": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "effect"],
          "properties": {
            "kind": {"type": "string", "const": "update"},
            "ref": {"type": "string", "minLength": 1},
            "effect": {"type": "string", "const": "obsolete"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "revision", "effect"],
          "properties": {
            "kind": {"type": "string", "const": "adoption"},
            "ref": {"type": "string", "minLength": 1},
            "revision": {"type": "integer", "minimum": 1},
            "effect": {"type": "string", "const": "pending_review"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "revision", "effect"],
          "properties": {
            "kind": {"type": "string", "const": "reference"},
            "ref": {"type": "string", "minLength": 1},
            "revision": {"type": "integer", "minimum": 1},
            "effect": {"type": "string", "enum": ["unresolved", "mixed_unchanged"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "ref", "revision", "effect"],
          "properties": {
            "kind": {"type": "string", "const": "trigger"},
            "ref": {"type": "string", "minLength": 1},
            "revision": {"type": "integer", "minimum": 1},
            "effect": {"type": "string", "const": "stop"}
          }
        }
      ]
    },
    "origin_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview_id", "actor", "memory_epoch"],
      "properties": {
        "preview_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "actor": {"type": "string", "const": "local_user_management"},
        "memory_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "origin_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preview", "applied"],
      "properties": {
        "preview": {"$ref": "#/$defs/origin_preview"},
        "applied": {"type": "boolean"},
        "result": {"$ref": "#/$defs/origin_result"}
      },
      "allOf": [
        {
          "if": {"properties": {"applied": {"type": "boolean", "const": true}}},
          "then": {"required": ["result"]},
          "else": {"not": {"required": ["result"]}}
        }
      ]
    },
    "origin_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "revision", "kind", "entry", "time", "rule", "affected_claims", "platform_id_available"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "kind": {"type": "string", "const": "event"},
        "entry": {"type": "string", "minLength": 1},
        "time": {"type": "string", "format": "date-time"},
        "rule": {"type": "string", "enum": ["gateway_origin", "replay_timestamp", "hermes_prefix", "legacy_review"]},
        "affected_claims": {"type": "integer", "minimum": 0},
        "platform_id_available": {"type": "boolean"},
        "snippet": {"type": "string", "maxLength": 120}
      }
    },
    "origin_candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "examined", "next_after"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/origin_candidate"}},
        "examined": {"type": "integer", "minimum": 0},
        "next_after": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "secret_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "rows_read", "candidates_scanned"],
      "properties": {
        "rows_read": {"type": "integer", "minimum": 0},
        "candidates_scanned": {"type": "integer", "minimum": 0},
        "items": {"type": "array", "items": {"$ref": "#/$defs/secret_finding"}}
      }
    },
    "secret_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "kind", "revision", "origin", "entry", "session", "time", "patterns"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "enum": ["event", "claim", "episode", "artifact", "reference"]},
        "revision": {"type": "integer", "minimum": 1},
        "origin": {"type": "string"},
        "entry": {"type": ["string", "null"]},
        "session": {"type": ["string", "null"]},
        "time": {"type": "string", "format": "date-time"},
        "patterns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "facts", "fact_history", "episodes", "attachments"],
      "properties": {
        "sources": {"type": "integer", "minimum": 0},
        "facts": {"type": "integer", "minimum": 0},
        "fact_history": {"type": "integer", "minimum": 0},
        "episodes": {"type": "integer", "minimum": 0},
        "attachments": {"type": "integer", "minimum": 0}
      }
    },
    "target": {
      "type": "object",
      "required": ["kind", "ref", "revision", "scope_id", "project_id", "branch_id"],
      "properties": {
        "kind": {"type": "string", "enum": ["event", "claim", "episode", "artifact", "reference"]},
        "ref": {"type": "string", "minLength": 1},
        "revision": {"type": "integer", "minimum": 1},
        "scope_id": {"type": "string"},
        "project_id": {"type": ["string", "null"]},
        "branch_id": {"type": ["string", "null"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "revision", "entry_id", "agent", "session", "occurred_at", "recorded_at"],
      "properties": {
        "ref": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1},
        "entry_id": {"type": "string"},
        "agent": {"type": "string"},
        "session": {"type": "string"},
        "occurred_at": {"type": ["string", "null"], "format": "date-time"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "memory_epoch", "targets", "affected", "sources", "preview_id"],
      "properties": {
        "mode": {"type": "string", "enum": ["delete", "suppress", "unmute"]},
        "memory_epoch": {"type": "integer", "minimum": 0},
        "targets": {"type": "array", "items": {"$ref": "#/$defs/target"}},
        "affected": {"type": "array", "items": {"$ref": "#/$defs/target"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "preview_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "item": {
      "type": "object",
      "required": ["kind", "ref", "revision"],
      "properties": {
        "kind": {"type": "string"},
        "ref": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1},
        "scope_id": {"type": "string"},
        "project_id": {"type": ["string", "null"]},
        "branch_id": {"type": ["string", "null"]},
        "suppressed": {"type": "integer", "enum": [0, 1]},
        "content": {"type": "string"},
        "state": {"type": "string"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "value": {"type": "object"},
        "memory_epoch": {"type": "integer", "minimum": 0},
        "sort_time": {"type": "string", "format": "date-time"}
      }
    },
    "data": {
      "type": "object",
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "next_cursor": {"type": ["string", "null"]},
        "next_before": {"type": ["integer", "null"]},
        "memory_epoch": {"type": "integer", "minimum": 0},
        "examined": {"type": "integer", "minimum": 0},
        "scan_complete": {"type": "boolean"},
        "stop_reason": {"type": "string", "enum": ["complete", "limit", "time_budget"]},
        "preview": {"type": "object", "anyOf": [{"$ref": "#/$defs/preview"}, {"$ref": "#/$defs/origin_preview"}]},
        "applied": {"type": "boolean"},
        "result": {"type": "object"},
        "kind": {"type": "string"},
        "ref": {"type": "string"},
        "revision": {"type": "integer", "minimum": 1},
        "value": {"type": "object"},
        "item": {"type": "object"},
        "actor": {"type": "string", "const": "local_user_management"},
        "action_id": {"type": "string"},
        "source_ref": {"type": "string"},
        "out": {"type": "string"},
        "package_format": {"type": "string", "const": "scope-recall-export/1"},
        "zip": {"type": "boolean"},
        "counts": {"$ref": "#/$defs/counts"}
      }
    },
    "origin_claim_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "state",
        "valid_from",
        "valid_to",
        "evidence_distribution",
        "evidence_refs",
        "selected_evidence_refs",
        "other_evidence_refs"
      ],
      "properties": {
        "revision": {"type": "integer", "minimum": 1},
        "state": {"type": "string", "enum": ["active", "proposed", "disputed", "superseded", "retracted"]},
        "valid_from": {"type": ["string", "null"]},
        "valid_to": {"type": ["string", "null"]},
        "evidence_distribution": {"type": "string", "enum": ["selected_only", "mixed", "elsewhere", "none"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^event-[^@]+@[1-9][0-9]*$"}
        },
        "selected_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^event-[^@]+@[1-9][0-9]*$"}
        },
        "other_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^event-[^@]+@[1-9][0-9]*$"}
        }
      }
    }
  }
}
